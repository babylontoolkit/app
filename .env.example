GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here

# Cohere
# Get your API key from: https://dashboard.cohere.ai/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Groq (Fast inference)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Mistral
# Get your API key from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here

# Together AI
# Get your API key from: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=your_together_api_key_here

# X.AI (Elon Musk's company)
# Get your API key from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Moonshot AI (Kimi models)
# Get your API key from: https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=your_moonshot_api_key_here

# Z.AI (GLM models with JWT authentication)
# Get your API key from: https://open.bigmodel.cn/usercenter/apikeys
ZAI_API_KEY=your_zai_api_key_here

# Hugging Face
# Get your API key from: https://huggingface.co/settings/tokens
HuggingFace_API_KEY=your_huggingface_api_key_here

# Hyperbolic
# Get your API key from: https://app.hyperbolic.xyz/settings
HYPERBOLIC_API_KEY=your_hyperbolic_api_key_here

# OpenRouter (Meta routing for multiple providers)
# Get your API key from: https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here

# ======================================
# CUSTOM PROVIDER BASE URLS (Optional)
# ======================================

# Ollama (Local models)
# DON'T USE http://localhost:11434 due to IPv6 issues
# USE: http://127.0.0.1:11434
OLLAMA_API_BASE_URL=http://127.0.0.1:11434

# OpenAI-like API (Compatible providers)
OPENAI_LIKE_API_BASE_URL=your_openai_like_base_url_here
OPENAI_LIKE_API_KEY=your_openai_like_api_key_here

# Together AI Base URL
TOGETHER_API_BASE_URL=your_together_base_url_here

# Hyperbolic Base URL
HYPERBOLIC_API_BASE_URL=https://api.hyperbolic.xyz/v1/chat/completions

# LMStudio (Local models)
# Make sure to enable CORS in LMStudio
# DON'T USE http://localhost:1234 due to IPv6 issues
# USE: http://127.0.0.1:1234
LMSTUDIO_API_BASE_URL=http://127.0.0.1:1234

# ======================================
# CLOUD SERVICES CONFIGURATION
# ======================================

# AWS Bedrock Configuration (JSON format)
# Get your credentials from: https://console.aws.amazon.com/iam/home
# Example: {"region": "us-east-1", "accessKeyId": "yourAccessKeyId", "secretAccessKey": "yourSecretAccessKey"}
AWS_BEDROCK_CONFIG=your_aws_bedrock_config_json_here

# ======================================
# GITHUB INTEGRATION
# ======================================

# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Used for importing/cloning repositories and accessing private repos
VITE_GITHUB_ACCESS_TOKEN=your_github_personal_access_token_here

# GitHub Token Type ('classic' or 'fine-grained')
VITE_GITHUB_TOKEN_TYPE=classic

# ======================================
# GITLAB INTEGRATION
# ======================================

# GitLab Personal Access Token
# Get your GitLab Personal Access Token here:
# https://gitlab.com/-/profile/personal_access_tokens
#
# This token is used for:
# 1. Importing/cloning GitLab repositories
# 2. Accessing private projects
# 3. Creating/updating branches
# 4. Creating/updating commits and pushing code
# 5. Creating new GitLab projects via the API
#
# Make sure your token has the following scopes:
# - api (for full API access including project creation and commits)
# - read_repository (to clone/import repositories)
# - write_repository (to push commits and update branches)
VITE_GITLAB_ACCESS_TOKEN=your_gitlab_personal_access_token_here

# Set the GitLab instance URL (e.g., https://gitlab.com or your self-hosted domain)
VITE_GITLAB_URL=https://gitlab.com

# GitLab token type should be 'personal-access-token'
VITE_GITLAB_TOKEN_TYPE=personal-access-token

# ======================================
# VERCEL INTEGRATION
# ======================================

# Vercel Access Token
# Get your access token from: https://vercel.com/account/tokens
# This token is used for:
# 1. Deploying projects to Vercel
# 2. Managing Vercel projects and deployments
# 3. Accessing project analytics and logs
VITE_VERCEL_ACCESS_TOKEN=your_vercel_access_token_here

# ======================================
# NETLIFY INTEGRATION
# ======================================

# Netlify Access Token
# Get your access token from: https://app.netlify.com/user/applications
# This token is used for:
# 1. Deploying sites to Netlify
# 2. Managing Netlify sites and deployments
# 3. Accessing build logs and analytics
VITE_NETLIFY_ACCESS_TOKEN=your_netlify_access_token_here

# ======================================
# SUPABASE INTEGRATION
# ======================================

# Supabase Project Configuration
# Get your project details from: https://supabase.com/dashboard
# Select your project → Settings → API
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Access Token (for management operations)
# Generate from: https://supabase.com/dashboard/account/tokens
VITE_SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# ======================================
# DEVELOPMENT SETTINGS
# ======================================

# Development Mode
NODE_ENV=development

# Application Port (optional, defaults to 5173 for development)
PORT=5173

# Logging Level (debug, info, warn, error)
VITE_LOG_LEVEL=debug

# Default Context Window Size (for local models)
DEFAULT_NUM_CTX=32768

# ======================================
# SETUP INSTRUCTIONS
# ======================================
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in the API keys for the services you want to use
# 3. All service integration keys use VITE_ prefix for auto-connection
# 4. Restart your development server: pnpm run dev
# 5. Services will auto-connect on startup if tokens are provided
# 6. Go to Settings > Service tabs to manage connections manually if needed

# ── Platform (Babylon Toolkit App Builder) ────────────────────────────────────
# Guards /api/admin/* (doc-sync refresh + prompt/skill rollback).
# UNSET = admin endpoints refuse to run. An unauthenticated prompt-rebuild endpoint
# would be a remote takeover of the agent's instructions, so "not configured" means closed.
ADMIN_TOKEN=

# Reveals Pro/BYOK UI (provider picker, model selector, key entry). Default false:
# the shipping product is credits-only with a fixed model (SPEC §4.1, §4.6.1).
PRO_FEATURES_ENABLED=false

# Starter-template pin (SPEC §4.4). UNSET = ON, which is the shipping default: new projects mount a
# PINNED, SHA-addressed snapshot from object storage, and a push to the starter repo reaches nobody
# until an admin promotes it (Settings > Admin > Starter template). Creation makes no GitHub call.
# Set false ONLY to develop the AppTemplate starter itself — then every new project tracks live main
# again, unreviewed, which is exactly what the pin exists to prevent.
# TEMPLATE_PINNING_ENABLED=false

# ⚠️ NEVER SET THIS IN A DEPLOYED ENVIRONMENT.
# Re-enables upstream bolt.diy's /api/chat and /api/llmcall. They have NO session check, NO credit
# gate and NO settlement, and they read the provider key straight from the server env — so with a
# platform ANTHROPIC_API_KEY set, either one is an unauthenticated, unattributable bill on our own
# key that routes around the /api/agent choke point (SPEC §4.5.4). They fail closed (404) by default
# and nothing in the product calls them. The flag exists for exactly one reason: bisecting our agent
# proxy against upstream's behaviour on a local machine.
UPSTREAM_LLM_ROUTES_ENABLED=false

# ⚠️ NEVER SET THIS IN A DEPLOYED ENVIRONMENT — it re-opens an UNAUTHENTICATED RCE.
# Re-enables upstream bolt.diy's SERVER-SIDE MCP execution. `MCPService` spawns a child process for
# every stdio server in the config, and the config arrives from an unauthenticated POST to
# /api/mcp-update-config — so on a deployed Node box, `curl` that route with a stdio `command` runs
# arbitrary commands on our infrastructure. SPEC §5 forbids server-side execution of user code, and
# §4.14 puts MCP execution in the user's WebContainer. The routes fail closed (404) by default; this
# flag exists only to bisect against upstream locally.
SERVER_SIDE_MCP_ENABLED=false

# ==============================================================================================
# Stage 3 — identity, persistence, and money (SPEC §4.5, §4.6, §4.6.1)
#
# ⚠️ NONE of these may be prefixed VITE_. Vite INLINES every VITE_* variable into the client
# bundle. The Supabase service-role key BYPASSES RLS — shipping it to a browser would hand every
# visitor every row in the database. (Upstream's VITE_SUPABASE_* is a DIFFERENT Supabase: the
# user's own game backend, §4.15. Those values are public by design. Ours are not.)
#
# Every one of these is OPTIONAL. With none of them set, the platform runs as a single local
# developer with filesystem persistence and a working credit ledger — the whole product is
# buildable and testable before a single vendor account exists (§1.3 principle 0).
# ==============================================================================================

# --- Platform Supabase: accounts, projects, snapshots, the credit ledger (§4.5) ---
# Unset => local single-user mode. Refuses to start in that mode when NODE_ENV=production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Object storage: snapshots, share builds, assets (§4.5.5) ---
# Unset => local filesystem under .data/storage. Set S3_BUCKET to switch to S3.
# Leave the keys unset in production so the SDK picks up the instance role instead.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Billing (§4.6) ---
# BILLING_ENFORCED=false (the default) is BETA MODE: usage is fully recorded, but a zero balance
# blocks nobody. true is launch mode. The system is credit-native either way.
BILLING_ENFORCED=false
GRANTS_ENABLED=true
# ⚠️ SIGNUP_GRANT_CREDITS is set ONCE, at the top of this file, next to LLM_PROVIDER — the two are one
# decision (see there). It used to be set in BOTH places with DIFFERENT values (500 up top, 1000 here),
# and since a later line wins in a real .env, copying this file silently handed out the Anthropic-sized
# grant while running on KIE. Two writers, one value, last-one-wins: do not re-add it here.
CREDIT_UNIT_COST_USD=0.01
# 4.0 ≈ 75% gross-margin target (§4.6); premium specialty-game pricing, realized ~72–75% at pack prices.
CREDIT_MARGIN=4.0

# FLAT credit price for CREATING a project (billing/rates.ts projectCreateCredits, ledger reason
# 'project_create', migration 0015). A New Project runs NO generation (§4.4a, 2026-07-29): it clones the
# pinned starter, installs it and serves it. That work costs a VM + a template fetch + storage, and costs
# it predictably, so it carries its own flat charge — debited at registration BEFORE anything is
# provisioned, so a refusal leaves nothing half-made. The BUILD turn the user sends afterwards is an
# ordinary turn billed cost-derived. 0 disables (creation is free); negative/garbage is ignored in favor
# of the default (100). Charged identically however the project arrives — a typed prompt and an import
# both go through the same POST /api/projects. Defined exactly ONCE — see the SIGNUP_GRANT_CREDITS note
# above for why.
PROJECT_CREATE_CREDITS=100

# --- Base-prompt cache warmer (prompt/cache-warmer.ts) ---
# Keeps the ONE prompt block that is byte-identical for every user (the base system prompt) warm in
# KIE's per-backend prompt cache, so user generations READ it at 0.1x instead of WRITING it at 2x.
# Platform-paid, pennies/day steady-state; fires on an interval plus once after each prompt promotion.
# It cannot warm per-project bytes (file context, doc routing), so this
# warmer is the only thing between a cold prefix and their bill. Interval must stay under the 60m cache TTL (values over 55 are ignored -> default 45).
CACHE_WARMER_ENABLED=true
CACHE_WARMER_INTERVAL_MINUTES=45
CACHE_WARMER_FANOUT=6

# --- Sandbox VM time: the OTHER cost the margin has to cover (CREDITS.md "Sandbox compute") ---
#
# "User project compute ~ $0" was true on WebContainer (the project ran in the user's own browser).
# A CodeSandbox microVM bills by WALL CLOCK, and the clock runs while the user THINKS. Metering is not
# built yet (owner decision 2026-07-27: bake into the margin now, measure with the Admin VM-hours
# report, meter later), so these two numbers are how that cost stays VISIBLE instead of quietly eating
# generation margin. `billing.spec.ts` asserts every pack still clears MIN_PACK_MARGIN with them.
#
# OPTIONAL OVERRIDE — leave it blank. The rate DERIVES from CODESANDBOX_VM_TIER (vmUsdPerHourForTier:
# measured $0.074/hr Pico, $0.149/hr Nano — Nano is the DEFAULT tier, so an unconfigured deploy prices
# compute at $0.149/hr; larger tiers derived at ~$0.0745 per CPU-hour; an unrecognised name prices at
# the most expensive tier we know, never the cheapest).
# "Raise it with the tier" used to live here as an instruction, and on 2026-07-28 an operator moved to
# Nano without moving this number — so the margin floor passed against HALF the real compute cost.
# Set it ONLY for a rate this cannot know about (a negotiated price, or a vendor change between
# releases); a value pinned here silently outranks the tier and re-arms that exact bug.
SANDBOX_VM_USD_PER_HOUR=
# The one ESTIMATE here: VM-hours dragged along by 1,000 billed credits. 8.33 is CREDITS.md's
# placeholder inverted (~120 credits per active build-hour). Lighter usage is WORSE, not better —
# an idle hour bills the VM and no credits. Replace it with the measurement once the report has data.
SANDBOX_EST_VM_HOURS_PER_KCREDIT=8.33

# --- Stripe: the platform's SOLE payment processor. No PayPal exists anywhere (§4.6). ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- RETIRED: Babylon Toolkit license service (licenser.asmx) ---
# The external ASMX SOAP license service was retired (§4.18). Entitlements no longer perform any
# network validation; Pro/BYOK is disabled by default and manual/testing-only (credits-based business).
# LICENSE_SERVICE_URL / LICENSE_SERVICE_SECRET are no longer read by any code path — do not set them.

# --- Unity Project License price ladder (§4.18) ---
# Generating a Unity Pro Tools license is a FLAT credit charge per tier, charged once per (Unity project,
# tier) and free to re-generate after. These override the default ladder (unity-license-pricing.ts); a
# negative or non-numeric value is ignored (falls back to the default). "Enterprise Studio" is the display
# name for the PremiumContent tier.
#   UNITY_LICENSE_CREDITS_INDIE=500
#   UNITY_LICENSE_CREDITS_SMALLBUSINESS=1000
#   UNITY_LICENSE_CREDITS_PREMIUMCONTENT=2000

# --- Absolute URLs for emails, OAuth redirects, and share links (§2.5) ---
APP_URL=
PLAY_URL=

# ── Upload ceilings (SPEC §5) ────────────────────────────────────────────────
# Every one of these bounds CLIENT-SUPPLIED bytes that the platform writes to object storage. They
# exist because an uncapped write is unbounded S3 + egress on YOUR bill, repeatable by any account
# holder. Each is a plain number; a missing or nonsensical value falls back to the default rather
# than disabling the cap.
#
# ⚠️ The two SOURCE caps — REMIX_SEED_MAX_MB and WORKING_COPY_MAX_MB — hold the same thing (the
# user's project) and default to the same number ON PURPOSE. Setting them apart creates projects the
# platform will hold for crash recovery, and publish happily, but never store a remix seed for: the
# game ends up public, playable and permanently un-remixable. That is now REPORTED in the Share
# dialog rather than only logged, but it is still better avoided than explained.
#
# ⚠️ A publish is bounded THREE times: the build, the remix seed, and the whole request body that
# carries both. PUBLISH_BODY_MAX_MB defaults to BUILD_MAX_MB + REMIX_SEED_MAX_MB + 10%, so raising
# either downstream cap is enough on its own — leave it unset unless you specifically need a
# different ceiling. If you DO set it below build + seed it becomes the real limit (the server warns
# when that happens), and the refusal the user sees names a different cap than the one you changed.

# The built game (dist/) uploaded to the public play bucket. NOT a source cap — a dist/ is served to
# the public on every play, so it has its own economics and its own number.
BUILD_MAX_MB=150
BUILD_MAX_FILES=10000

# The project SOURCE kept so strangers can Remix a published game (§4.8). Deleted on unpublish.
# Keep this equal to WORKING_COPY_MAX_MB — see the warning above.
REMIX_SEED_MAX_MB=256

# Header-level reject on the whole publish request, before anything is decoded.
# Unset = BUILD_MAX_MB + REMIX_SEED_MAX_MB + 10% (447MB with the defaults above).
# PUBLISH_BODY_MAX_MB=447

# Crash-recovery working copy (SPEC §4.5.4c)
# The platform keeps ONE recovery copy per project so a browser crash cannot take the user's game
# with it. This caps the serialized copy (all files, binaries base64'd) — §5 requires a cap because
# this write fires on every checkpoint. Default 256. A project past the limit is NOT protected and
# the user is told so, so raise this rather than leaving projects unprotected.
WORKING_COPY_MAX_MB=256
